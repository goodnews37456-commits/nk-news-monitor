{
  "name": "북한 NEWS Monitor",
  "short_name": "북한 NEWS",
  "description": "북한 관련 최신 뉴스를 한눈에 확인하는 뉴스 모니터",
  "lang": "ko",
  "dir": "ltr",

  "start_url": "./index.html",
  "scope": "./",

  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],

  "orientation": "portrait",

  "theme_color": "#082451",
  "background_color": "#f5f6f8",

  "categories": [
    "news",
    "information"
  ],

  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],

  "prefer_related_applications": false
}
